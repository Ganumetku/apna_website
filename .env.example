# Origins allowed to iframe this editor and send LOAD_PDF.
# Comma-separated. No trailing paths. Restart `npm run dev` after changing this.
# Production:
#   https://toolwala.com,https://www.toolwala.com
# Local Next.js (default port 3000):
VITE_ALLOWED_ORIGINS=https://toolwala.com,https://www.toolwala.com,http://localhost:3000

# Embed mode hides Download and shows "Save & Continue".
# Set to true to also keep a Download button inside the iframe.
VITE_EMBED_SHOW_DOWNLOAD=false
